generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VibeStatus {
  PENDING
  VOICE1_SENT
  VOICE2_RECEIVED
  VOICE3_SENT
  SYNCED
  SKIPPED
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  vibeStatus VibeStatus @default(PENDING)
  vibes     Vibe[]
  createdAt DateTime @default(now())
}

model Vibe {
  id          String   @id @default(cuid())
  userId      String
  matchId     String?
  status      VibeStatus @default(PENDING)
  audioUrl    String?
  duration    Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model VibeChain {
  id          String     @id @default(cuid())
  senderId    String
  receiverId  String
  status      VibeStatus @default(PENDING)
  voice1Url   String? // 30sec intro
  voice2Url   String? // 10sec reactie
  voice3Url   String? // 20sec finale
  syncScore   Float?
  createdAt   DateTime   @default(now())

  @@unique([senderId, receiverId])
}
model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  age          Int
  interests    String[]
  dailyVoices  Int      @default(1)
  dailyListens Int      @default(3)
  createdAt    DateTime @default(now())
}

model VoiceMessage {
  id         String     @id @default(cuid())
  senderId   String
  receiverId String?
  status     VibeStatus @default(PENDING)
  audioUrl   String?
  createdAt  DateTime   @default(now())
}
